  :tag => '6.0.1'

# EL9 FORK -- upstream 7.0.2 plus two fixes:
#   * /var/named forced to 0750, which BIND rejects: it is started -u named and
#     checks its `directory` is writable, so it exits during config parsing.
#     The bind RPM ships 1770 (drwxrwx--T) deliberately. Both install.pp and
#     chroot.pp were affected.
#   * the rsync username was built from $server_facts['environment'], which is
#     empty under `puppet apply` and collapses the name to a double underscore.
mod 'simp-named',
  :git => "#{el9_fork_base}/pupmod-simp-named",
  :tag => '7.0.3-el9'

