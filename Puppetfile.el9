# TEMPORARILY EXCLUDED -- MUST BE RESTORED BEFORE THE ISO IS USABLE
#
# WARNING: an earlier revision of this comment claimed omitting r10k was safe
# because no RPM Requires it. That is true of the RPM metadata and false in
# practice: `simp config` deploys every Puppet module by shelling out to r10k
# (simp-cli, lib/simp/cli/environment/puppet_dir_env.rb) --
#
#     r10k = '/usr/share/simp/bin/r10k' if File.executable?(...)
#     r10k_cmd = "#{r10k} puppetfile install -v info"
#
# -- so without it `simp config` dies on that line and NOTHING can be deployed.
# Confirmed on the 10.20.31.131 test install. See docs/el9-bootstrap-blockers.md.
#
# Two things block a straight rebuild of the upstream component:
#   1. Gemfile pins r10k 3.11 (gemspec: ruby ~> 2.3) and puppet ~> 6.2, so
#      `bundle install` cannot resolve on the EL9 build host (Ruby 3.3).
#   2. Rakefile calls ERB.new(tmpl, nil, '-'); the 3-arg form was removed in
#      Ruby 3.1 and must become ERB.new(tmpl, trim_mode: '-').
#
# r10k 5.0.3 runs correctly on OpenVox's Ruby 3.2.11. Only 12 pure-Ruby gems
# need vendoring (OpenVox's Ruby supplies the other 16 in the closure, including
# every gem with a native extension), so BuildArch: noarch still holds.
#
# mod 'simp-vendored_r10k',
#   :git => 'https://github.com/simp/pkg-r10k',
#   :tag => '3.14.2-1'

